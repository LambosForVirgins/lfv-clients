{
    "name": "storybook",
    "version": "0.0.1",
    "private": true,
    "main": "index.ts",
    "scripts": {
        "start": "yarn start:stories",
        "start:docs": "storybook dev -p 6006 -c .storybook-docs",
        "start:stories": "storybook dev -p 6007 -c .storybook-stories",
        "docs": "storybook dev --docs",
        "build": "yarn build:docs",
        "build:docs": "storybook build -c .storybook-docs -o storybook-static-docs",
        "build:stories": "storybook build -c .storybook-stories -o storybook-static-stories",
        "__lint__": "__lint__",
        "lint": "yarn lint:ts",
        "lint:ts": "echo \"Linting storybook TypeScript...\" && tsc --noEmit && echo \"All storybook files follow TypeScript standards!\""
    },
    "devDependencies": {
        "@storybook/addon-docs": "9.0.13",
        "@storybook/addon-essentials": "8.6.14",
        "@storybook/addon-interactions": "8.6.14",
        "@storybook/addon-links": "9.0.13",
        "@storybook/blocks": "8.6.14",
        "@storybook/components": "8.6.14",
        "@storybook/core-events": "8.6.14",
        "@storybook/manager-api": "8.6.14",
        "@storybook/preview-api": "8.6.14",
        "@storybook/react-vite": "9.0.13",
        "@storybook/test": "8.6.14",
        "@storybook/testing-library": "0.2.2",
        "@storybook/theming": "8.6.14",
        "@storybook/types": "8.6.14",
        "@vitejs/plugin-react": "4.2.1",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "react-router": "7.1.3",
        "storybook": "9.0.13"
    }
}
